# Copy to .env.local and fill in real values. Never commit .env.local
# (it is already gitignored). Until these are set, the app runs in
# "Clerk stub mode": middleware and the provider are skipped so local
# development and the build both work without a real Clerk account.

# From a Clerk application dashboard (clerk.com) - Alpesh creates this
# account; it is not created or accessed by any automated tool call.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
